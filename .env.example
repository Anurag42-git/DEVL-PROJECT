# Copy to .env and fill in real values. .env is git-ignored.

# ---------- PostgreSQL (Experiments 5 & 7) ----------
PG_HOST=localhost
PG_PORT=5432
PG_DB=payment_monitor
PG_USER=postgres
PG_PASSWORD=postgres

# ---------- MongoDB (Experiments 8 & 9) ----------
# Set MONGO_URI to an empty string to force the in-memory mongomock fallback.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=payment_monitor

# ---------- Pipeline ----------
DATA_DIR=data
LOG_LEVEL=INFO
RANDOM_SEED=42

# ---------- Thresholds (overridable; config/settings.yaml holds the defaults) ----------
VELOCITY_WINDOW_MIN=30
VELOCITY_MAX_TXNS=6
FAILED_ATTEMPT_WINDOW_MIN=10
FAILED_ATTEMPT_MAX=3
REFUND_RATIO_THRESHOLD=0.35
SHARED_DEVICE_CUSTOMER_LIMIT=4
